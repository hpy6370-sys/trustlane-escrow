# Copy to .env. NEVER commit .env.
PORT=4000
NODE_ENV=development
# SQLite file (directory is created automatically). On Render/Railway point this at a persistent disk.
DATABASE_PATH=./data/escrow.db
# Long random string, REQUIRED when NODE_ENV=production (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
JWT_SECRET=
JWT_TTL=12h
# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173
# Domain shown in the sign-in message (should match where the frontend is served)
SIWE_DOMAIN=localhost:5173

# Chain: 31337 = local Hardhat node, 11155111 = Sepolia
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
# For Sepolia, e.g.: RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<your-key>

# Event indexer
INDEXER_ENABLED=true
INDEXER_POLL_MS=4000
# Max block range per eth_getLogs call (Alchemy free tier needs a small value, e.g. 10)
LOG_CHUNK=500
# Blocks to wait before indexing (use 3+ on Sepolia to ride out small reorgs)
CONFIRMATIONS=0

# Only used when the RPC is unreachable: comma-separated addresses treated as Admin
ADMIN_ADDRESSES=
