# Copy to .env and fill in. NEVER commit .env.
# Sepolia RPC (Alchemy / Infura / publicnode). Public fallback is used if empty.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<your-key>
# Private key of a Sepolia-only test wallet that holds some Sepolia ETH (0x-prefixed)
DEPLOYER_PRIVATE_KEY=0x<test-wallet-private-key>
# Optional: hand the Admin role to another address after deployment (defaults to deployer)
ADMIN_ADDRESS=
# Platform fee in basis points (250 = 2.5 %, max 1000)
PLATFORM_FEE_BPS=250
# Optional: contract verification on Etherscan
ETHERSCAN_API_KEY=
# Set to "false" to skip gas reporting during tests
REPORT_GAS=true
